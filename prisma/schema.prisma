// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  email             String   @unique
  password          String
  jwtToken          String   @unique
  jwtTokenExpiresAt DateTime
  jwtTokenCreatedAt DateTime @default(now())
  jwtTokenUpdatedAt DateTime @updatedAt

  // 2FA. `twoFactorEnabledAt` é o flag: secret preenchido sem ele = enrolamento
  // começado e não confirmado, que não exige nada no login.
  twoFactorSecret      String?
  twoFactorEnabledAt   DateTime?
  // Hashes SHA-256 dos códigos de uso único. Item sai do array ao ser usado.
  twoFactorBackupCodes String[]

  // Reset de senha. SHA-256 e não bcrypt: o token é aleatório de alta entropia
  // gerado por nós, não senha humana — bcrypt só somaria latência.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ponytail: colunas por locale servem 2 idiomas; 3o idioma -> tabela
// Translation(entity, entityId, field, locale)
model Post {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  titleEn    String?
  content    String
  contentEn  String?
  images     String[]
  categoryId Int
  publishedAt DateTime?
  category   Category @relation(fields: [categoryId], references: [id])
  summary    String
  summaryEn  String?
  comments   Comment[]
  likes      PostLike[]
  views      PostView[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum CommentStatus {
  PUBLISHED
  PENDING
}

model Comment {
  id          Int           @id @default(autoincrement())
  postId      Int
  parentId    Int?
  authorName  String
  authorEmail String?
  content     String
  status      CommentStatus @default(PUBLISHED)
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postId])
  @@index([parentId])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  ipHash    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, ipHash])
  @@index([postId])
}

model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int
  ipHash    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, ipHash])
  @@index([postId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  nameEn    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model ResumeHeader {
  id        Int      @id @default(autoincrement())
  name      String
  jobTitle  String
  jobTitleEn String?
  summary   String
  summaryEn String?
  location  String
  email     String
  phone     String
  website   String
  linkedin  String
  github    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  images        String[]
  technologies  String[]
  link          String?
  githubLink    String?
  youtubeLink   String?
  instagramLink String?
  twitterLink   String?
  facebookLink  String?
  collaborators String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Skill {
  id          Int      @id @default(autoincrement())
  name        String
  level       Int
  description String?
  descriptionEn String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          Int       @id @default(autoincrement())
  company     String
  position    String
  positionEn  String?
  description String
  descriptionEn String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Education {
  id           Int       @id @default(autoincrement())
  school       String
  degree       String
  degreeEn     String?
  fieldOfStudy String
  fieldOfStudyEn String?
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Language {
  id        Int      @id @default(autoincrement())
  name      String
  nameEn    String?
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
